# Foundation CLI — environment variables example
#
# Copy this file to one of:
#   - foundation.env     next to your active config (default:
#                        ~/.config/foundation/foundation.env), loaded
#                        automatically before process env vars
#   - .env               if your shell or process manager loads it
#
# Precedence (highest wins): real exported env vars > foundation.env >
# config.toml > code defaults. CLI flags such as --model / --provider /
# --approval-mode override everything for a single invocation.
#
# Foundation reads nested settings via the FOUNDATION_<SECTION>__<FIELD>
# convention (double underscore between section and field).


# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# OpenAI (default provider). Also resolvable from the macOS keychain at
# service "foundation", username "openai_api_key".
OPENAI_API_KEY=

# Ollama Cloud. Local Ollama at http://localhost:11434/api needs no key.
# OLLAMA_API_KEY=


# ---------------------------------------------------------------------------
# Provider selection (usually set in config.toml; override here if needed)
# ---------------------------------------------------------------------------
# FOUNDATION_PROVIDER__NAME=openai
# FOUNDATION_PROVIDER__MODEL=gpt-5-mini
# FOUNDATION_PROVIDER__BASE_URL=https://api.openai.com/v1
# FOUNDATION_PROVIDER__REQUEST_TIMEOUT_SECONDS=60


# ---------------------------------------------------------------------------
# App paths
# ---------------------------------------------------------------------------
# FOUNDATION_APP__WORKSPACE_ROOT=/path/to/workspace
# FOUNDATION_APP__DATA_DIR=~/.local/share/foundation
# FOUNDATION_APP__STATE_DIR=~/.local/state/foundation
# FOUNDATION_APP__LOG_DIR=~/.local/state/foundation/logs


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
# FOUNDATION_LOGGING__LEVEL=WARNING
# FOUNDATION_LOGGING__STRUCTURED=false


# ---------------------------------------------------------------------------
# Approval policy
# ---------------------------------------------------------------------------
# prompt | auto | auto-except-commit | manual
# FOUNDATION_APPROVAL__MODE=prompt
# FOUNDATION_APPROVAL__REQUIRE_DESTRUCTIVE=true
# FOUNDATION_APPROVAL__REQUIRE_NETWORK=true
# FOUNDATION_APPROVAL__REQUIRE_OUTSIDE_WORKSPACE=true


# ---------------------------------------------------------------------------
# Shell execution policy
# ---------------------------------------------------------------------------
# FOUNDATION_SHELL__DEFAULT_TIMEOUT_SECONDS=300
# FOUNDATION_SHELL__MAX_TIMEOUT_SECONDS=3600
# FOUNDATION_SHELL__ALLOW_PTY=true
# FOUNDATION_SHELL__CAPTURE_LIMIT_KB=256
# FOUNDATION_SHELL__ENFORCE_WORKSPACE_BOUNDARY=true
# FOUNDATION_SHELL__PASS_THROUGH_FOUNDATION_ENV=false


# ---------------------------------------------------------------------------
# History (SQLite trace store)
# ---------------------------------------------------------------------------
# FOUNDATION_HISTORY__DATABASE_PATH=~/.local/state/foundation/history.sqlite3
# FOUNDATION_HISTORY__RETENTION_DAYS=30
# FOUNDATION_HISTORY__MAX_ENTRIES=5000


# ---------------------------------------------------------------------------
# Monitor / event log (v4)
# ---------------------------------------------------------------------------
# Set FOUNDATION_MONITOR=0 to disable the NDJSON event log entirely.
# FOUNDATION_MONITOR=1
# FOUNDATION_MONITOR__ENABLED=true
# FOUNDATION_MONITOR__EVENTS_DIR=~/.local/state/foundation/events
# FOUNDATION_MONITOR__FLUSH_INTERVAL_MS=200
# FOUNDATION_MONITOR__SUBSCRIBER_QUEUE_SIZE=1024
# FOUNDATION_MONITOR__RETENTION__MAX_SESSIONS=200
# FOUNDATION_MONITOR__RETENTION__MAX_BYTES=524288000

# Optional live transports (off by default). Mirror of --monitor-socket
# and --monitor-http=<port>.
# FOUNDATION_MONITOR_SOCKET=1
# FOUNDATION_MONITOR_HTTP=8765


# ---------------------------------------------------------------------------
# UX
# ---------------------------------------------------------------------------
# Set to 1/true/yes to disable the live-turn rich UI (useful in CI logs).
# FOUNDATION_DISABLE_LIVE_UX=0
