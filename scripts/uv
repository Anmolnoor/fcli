#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UV_BIN="${ROOT_DIR}/.venv/bin/uv"

if [[ ! -x "${UV_BIN}" ]]; then
  echo "Missing ${UV_BIN}. Run ./scripts/bootstrap.sh first." >&2
  exit 1
fi

export UV_CACHE_DIR="${ROOT_DIR}/.uv-cache"
mkdir -p "${UV_CACHE_DIR}"

exec "${UV_BIN}" "$@"
